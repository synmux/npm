{
  "author": {
    "email": "so9js0owd@mozmail.com",
    "name": "syn",
    "url": "https://syn.horse"
  },
  "bin": {
    "synmux": "dist/cmd.js"
  },
  "bugs": {
    "url": "https://github.com/synmux/npm/issues"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "chalk-animation": "^2.0.3",
    "cli-table3": "^0.6.5",
    "gradient-string": "^3.0.0",
    "ora": "^9.4.1",
    "update-notifier": "^7.3.1"
  },
  "description": "Metapackage for syn",
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "skilld": "^2.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^24.20.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/synmux/npm#readme",
  "license": "MIT",
  "main": "./dist/index.js",
  "name": "@synmux/npm",
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synmux/npm.git"
  },
  "scripts": {
    "build": "pnpm run clean && esbuild src/index.ts src/cmd.ts --bundle --splitting --platform=node --target=node24 --format=esm --packages=external --outdir=dist && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "docker": "pnpm run docker:build && pnpm run docker:run",
    "docker:build": "docker build -t syn-horse:latest -f Dockerfile .",
    "docker:run": "docker run -it --rm syn-horse:latest",
    "gif": "vhs npm.tape && gif2webp -m 6 -min_size -mt -v assets/npm.gif -o assets/npm.webp && rm assets/npm.gif",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:types": "tsc --noEmit",
    "prepare": "skilld prepare || true",
    "prepublishOnly": "pnpm run lint && pnpm run lint:types && pnpm run test && pnpm run build",
    "start": "node src/cmd.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "1.0.8"
}
