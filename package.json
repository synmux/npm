{
  "author": {
    "email": "so9js0owd@mozmail.com",
    "name": "syn",
    "url": "https://syn.horse"
  },
  "bin": {
    "synmux": "dist/cmd.js"
  },
  "bugs": {
    "url": "https://github.com/synmux/npm/issues"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "chalk-animation": "^2.0.3",
    "cli-table3": "^0.6.5",
    "gradient-string": "^3.0.0",
    "ora": "^9.4.1",
    "update-notifier": "^7.3.1"
  },
  "description": "Meta package for syn",
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.1",
    "skilld": "^2.3.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": "^1.4.0"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/synmux/npm#readme",
  "license": "MIT",
  "main": "./dist/index.js",
  "name": "@synmux/npm",
  "packageManager": "bun@1.4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synmux/npm.git"
  },
  "scripts": {
    "build": "bun run clean && bun build --target node --minify --sourcemap ./src/index.ts ./src/cmd.ts --outdir dist",
    "clean": "rm -rf dist",
    "docker": "bun run docker:build && bun run docker:run",
    "docker:build": "docker build -t syn-horse:latest -f Dockerfile .",
    "docker:run": "docker run -it --rm syn-horse:latest",
    "lint": "bun x @biomejs/biome check .",
    "lint:fix": "bun x @biomejs/biome check --write .",
    "prepublishOnly": "bun run lint:fix && bun run test && bun run build",
    "start": "bun src/cmd.ts",
    "gif": "vhs npm.tape && gif2webp -m 6 -min_size -mt -v assets/npm.gif -o assets/npm.webp && rm assets/npm.gif",
    "test": "bun test",
    "prepare": "skilld prepare || true"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "@google/genai",
    "onnxruntime-node",
    "protobufjs",
    "sharp"
  ],
  "type": "module",
  "version": "1.0.8"
}
